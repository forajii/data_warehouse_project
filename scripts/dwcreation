/* 
Create the Database and Schemas:
Purpose of Script: 
The script creates a new database 'DataWarehouse' to check if it already exists. If it exists, it is dropped and recreated. 
The script also sets up three schemas 'bronze', 'silver', and 'gold' for different layers of the data engineering process.

NOTE:
Running this script will drop the entirety of 'DataWarehouse' in the case that it does exist. All data in the database will 
be deleted, so proceed with caution.

--DROP AND RECREATE DATABASE
IF EXISTS(SELECT 1 FROM sys.databases WHERE name = 'DataWarehouse')
BEGIN
    ALTER DATABASE DataWarehouse SET SINGLE_USER WITH ROLLBACK IMMEDIATE;
    DROP DATABASE WAREHOUSE;
END;
GO
*/

--Start creating the database for DataWarehouse
CREATE DATABASE DataWarehouse
GO
USE DataWarehouse
GO

CREATE SCHEMA bronze;
GO;
CREATE SCHEMA silver;
GO;
CREATE SCHEMA gold;
GO



